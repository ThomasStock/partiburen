---
import Layout from "../layouts/Layout.astro";
import content from "../data/home.json";
import Post from "../components/Post.astro";
import Instagram from "../components/Instagram.astro";
import { visiblePosts, type PostData } from "../lib/posts";

const hero: { title: string; badge?: string | null; badgeAlt?: string | null } = content.hero;
const entries = import.meta.glob<PostData>("../data/posts/*.json", { eager: true, import: "default" });
const posts = visiblePosts(Object.values(entries));
---

<Layout>
  <header class="w-full relative overflow-hidden">
    <div class="absolute inset-0 top-8 sm:top-24 bottom-auto flex flex-col justify-center text-white text-center drop-shadow-lg">
      <div class="">
        <h1 class="sm:text-6xl text-5xl leading-snug">{content.hero.title}</h1>
        <h2 class="sm:text-lg text-neutral-50 text-sm">{content.hero.subtitle}</h2>
      </div>
    </div>
    <img src={content.hero.image} alt={content.hero.imageAlt} class="w-full" />
    {hero.badge && <img src={hero.badge} alt={hero.badgeAlt ?? ""} class="absolute md:bottom-4 md:right-4 bottom-1 right-1 w-24 md:w-32 h-auto" />}
  </header>
  <div class="p-4 mt-6 flex flex-row gap-12 justify-center items-center">
    <a href="https://www.instagram.com/de_partiburen" target="_blank" class="shrink-0"
      ><img
        src="/instagram.png"
        alt="Instagram"
        class="size-12"
      /></a
    >
    <a href="https://www.facebook.com/profile.php?id=100085963819719" target="_blank" class="shrink-0"
      ><img src="/facebook.png" alt="Facebook" class="size-12" /></a
    >
  </div>
  <main>
    {posts.map((post) => <Post post={post} />)}

    <div class="p-4 flex flex-col sm:items-stretch sm:flex-row gap-12 sm:gap-4">
      <iframe
        style="border-radius:12px"
        class="h-[352px] sm:h-auto"
        src="https://open.spotify.com/embed/playlist/5cTvDz05adEOop9zYRiyBx?utm_source=generator&theme=0"
        width="100%"
        allowfullscreen=""
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"></iframe>

      <Instagram settings={content.instagram} />
    </div>


    <div class="flex justify-center text-neutral-600 p-4 pb-8">
      Lid van&nbsp;<a class="underline" href="https://www.koorenstem.be/nl">Koor&amp;Stem vzw</a>
    </div>
  </main>
</Layout>
