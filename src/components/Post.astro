---
import type { PostData } from "../lib/posts";
import PostImages from "./PostImages.astro";
interface Props { post: PostData }
const { post } = Astro.props;
---

<article>
  <div class="p-4">
    <h1 class="text-3xl leading-relaxed mb-2">{post.title}</h1>
    <div class="cms-copy" set:html={post.body} />
    {post.link?.url && (
      <p class="mt-2">
        <a href={post.link.url} target="_blank" rel="noopener noreferrer" class="underline">
          {post.link.label || "Lees meer"}
        </a>
      </p>
    )}
  </div>
  <PostImages images={post.images ?? []} title={post.title} />
  {post.video && (
    <div class="p-4">
      <iframe width="100%" class="aspect-video" src={post.video} title={`Video: ${post.title}`} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </div>
  )}
</article>

<style is:global>
  .cms-copy p + p { margin-top: 0.5rem; }
  .cms-copy a { text-decoration: underline; }
  .cms-copy ul { list-style: disc; padding-left: 1.5rem; }
  .cms-copy ol { list-style: decimal; padding-left: 1.5rem; }
</style>
