---
interface Props {
  images: { src: string; alt?: string | null }[];
  title: string;
}
const { images: entries, title } = Astro.props;
const images = entries.filter((image) => image.src?.trim());
---

{images.length === 1 && (
  <img src={images[0].src} alt={images[0].alt ?? ""} class="w-full my-4 mb-8" />
)}
{images.length > 1 && (
  <post-carousel class="my-4 mb-8" role="region" aria-roledescription="carrousel" aria-label={`Foto's: ${title}`}>
    <div class="slides" tabindex="0" aria-label="Foto's; gebruik de pijltjestoetsen of veeg">
      {images.map((image, index) => (
        <div class="slide" role="group" aria-roledescription="dia" aria-label={`${index + 1} van ${images.length}`}>
          <img src={image.src} alt={image.alt ?? ""} loading={index === 0 ? "eager" : "lazy"} draggable="false" />
        </div>
      ))}
    </div>
    <button class="previous" type="button" aria-label="Vorige foto" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <button class="next" type="button" aria-label="Volgende foto" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </button>
    <span class="sr-only" aria-live="polite" aria-atomic="true">Foto 1 van {images.length}</span>
  </post-carousel>
)}

<script>
  class PostCarousel extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      const track = this.querySelector<HTMLDivElement>(".slides")!;
      const slides = this.querySelectorAll<HTMLDivElement>(".slide");
      const firstImage = this.querySelector<HTMLImageElement>("img")!;
      const status = this.querySelector<HTMLElement>("[aria-live]")!;
      const buttons = this.querySelectorAll<HTMLButtonElement>("button");
      let current = 0;
      // Keep the first photo's natural proportions and fit other photos without cropping.
      const size = () => {
        if (firstImage.naturalWidth && firstImage.naturalHeight) {
          track.style.aspectRatio = `${firstImage.naturalWidth} / ${firstImage.naturalHeight}`;
        }
      };
      firstImage.addEventListener("load", size, { once: true });
      size();
      const go = (index: number) => {
        current = (index + slides.length) % slides.length;
        track.scrollTo({
          left: current * track.clientWidth,
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
        });
      };
      buttons.forEach((button) => { button.hidden = false; });
      buttons[0].addEventListener("click", () => go(current - 1));
      buttons[1].addEventListener("click", () => go(current + 1));
      track.addEventListener("scroll", () => {
        current = Math.round(track.scrollLeft / track.clientWidth);
        status.textContent = `Foto ${current + 1} van ${slides.length}`;
      }, { passive: true });
      track.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        go(event.key === "Home" ? 0 : event.key === "End" ? slides.length - 1 : current + (event.key === "ArrowRight" ? 1 : -1));
      });
    }
  }
  if (!customElements.get("post-carousel")) customElements.define("post-carousel", PostCarousel);
</script>

<style>
  post-carousel { display: block; position: relative; width: 100%; }
  .slides {
    display: flex;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    background: #f5f5f5;
  }
  .slides::-webkit-scrollbar { display: none; }
  .slide { flex: 0 0 100%; min-width: 0; height: 100%; scroll-snap-align: start; scroll-snap-stop: always; }
  .slide img { display: block; width: 100%; height: 100%; object-fit: contain; }
  button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(0 0 0 / 55%);
    color: white;
    cursor: pointer;
  }
  button[hidden] { display: none; }
  button:hover { background: rgb(0 0 0 / 75%); }
  button:focus-visible, .slides:focus-visible { outline: 3px solid #fff; outline-offset: -4px; box-shadow: inset 0 0 0 6px #222; }
  button svg { width: 24px; height: 24px; }
  .previous { left: 12px; }
  .next { right: 12px; }
</style>
